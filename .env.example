# Firebase web app config
# Copy these into Vercel Project Settings -> Environment Variables.
# Also copy them into .env.local if you run the app on your computer.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: keep the same Firebase project but separate each cafe/restaurant's data.
NEXT_PUBLIC_FIREBASE_STATE_COLLECTION=cafes
NEXT_PUBLIC_FIREBASE_CAFE_ID=corner-cafe-demo
